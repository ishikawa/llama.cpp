inline uint iq2_s_ep_load32(device const uchar * p, bool aligned) {
    if (aligned) {
        return *((device const uint *)p);
    }
    return uint(p[0]) | (uint(p[1]) << 8) | (uint(p[2]) << 16) | (uint(p[3]) << 24);
}

inline uint iq2s_compact_expand4(uint code) {
    code &= 255;
    code = (code | (code << 12)) & 0x000f000f;
    code = (code | (code << 6)) & 0x03030303;
    return 0x08080808 + 17*code + ((code >> 1) & 0x01010101);
}

template<bool TG>
inline float iq2s_compact_dot32(uint q, uint sign, uchar qh, uchar sc, float db, thread const float * yl, threadgroup const ushort * table) {
    const uchar4 qs = as_type<uchar4>(q);
    const uchar4 signs = as_type<uchar4>(sign);
    const float d1 = db*(0.5f + (sc & 15));
    const float d2 = db*(0.5f + (sc >> 4));
    float2 sum = {0.f};
    for (short l = 0; l < 2; ++l) {
        const int index1 = qs[l] | ((qh << (8-2*l)) & 0x300);
        const int index2 = qs[l+2] | ((qh << (4-2*l)) & 0x300);
        const ushort c1 = TG ? table[index1] : iq2s_grid_compact[index1];
        const ushort c2 = TG ? table[index2] : iq2s_grid_compact[index2];
        const uint2 grid1 = uint2(iq2s_compact_expand4(c1), iq2s_compact_expand4(c1 >> 8));
        const uint2 grid2 = uint2(iq2s_compact_expand4(c2), iq2s_compact_expand4(c2 >> 8));
#pragma unroll
        for (short j = 0; j < 8; ++j) {
            const float w1 = float((grid1[j/4] >> (8*(j%4))) & 255);
            const float w2 = float((grid2[j/4] >> (8*(j%4))) & 255);
            sum[0] += yl[8*l+j]*w1*select(1, -1, signs[l] & kmask_iq2xs[j]);
            sum[1] += yl[8*l+j+16]*w2*select(1, -1, signs[l+2] & kmask_iq2xs[j]);
        }
    }
    return d1*sum[0] + d2*sum[1];
}

template<bool TG>
inline float moe_gate_up_dot_iq2_s_compact(device const block_iq2_s * xb, short ib, thread const float * yl, threadgroup char * shmem) {
    device const uchar * qs = xb->qs + 4*ib;
    device const uchar * signs = qs + 32;
    // IQ2_S block and qs addresses need not be uint aligned.
    const uint q = uint(qs[0]) | (uint(qs[1]) << 8) | (uint(qs[2]) << 16) | (uint(qs[3]) << 24);
    const uint sign = uint(signs[0]) | (uint(signs[1]) << 8) | (uint(signs[2]) << 16) | (uint(signs[3]) << 24);
    return iq2s_compact_dot32<TG>(q, sign, xb->qh[ib], xb->scales[ib], float(xb->d), yl, (threadgroup const ushort *)shmem);
}

template<bool TG>
inline float moe_gate_up_dot_iq2_s_ep_compact(device const char * expert, ulong block, ulong blocks, short ib, thread const float * yl, threadgroup char * shmem) {
    device const uchar * payload = (device const uchar *)expert + 80*block;
    const uint q = *((device const uint *)(payload + 4*ib));
    const uint sign = *((device const uint *)(payload + 32 + 4*ib));
    const float d = ((device const half *)(expert + 80*blocks))[block];
    return iq2s_compact_dot32<TG>(q, sign, payload[64+ib], payload[72+ib], d, yl, (threadgroup const ushort *)shmem);
}

template<typename y_t>
inline float iq2_s_ep_dot32(uint q, uint sign, uchar qh, uchar sc, float db, y_t yl) {
    const uchar4 qs = as_type<uchar4>(q);
    const uchar4 signs = as_type<uchar4>(sign);
    const float d1 = db * (0.5f + (sc & 0xf));
    const float d2 = db * (0.5f + (sc >> 4));
    float2 sum = {0.f};
    for (short l = 0; l < 2; ++l) {
        const int index1 = qs[l] | ((qh << (8-2*l)) & 0x300);
        const int index2 = qs[l+2] | ((qh << (4-2*l)) & 0x300);
        constant uchar * grid1 = (constant uchar *)(iq2s_grid + index1);
        constant uchar * grid2 = (constant uchar *)(iq2s_grid + index2);
        for (short j = 0; j < 8; ++j) {
            sum[0] += yl[8*l+j] * float(grid1[j]) * select(1, -1, signs[l] & kmask_iq2xs[j]);
            sum[1] += yl[8*l+j+16] * float(grid2[j]) * select(1, -1, signs[l+2] & kmask_iq2xs[j]);
        }
    }
    return d1*sum[0] + d2*sum[1];
}

template<int DIAG>
inline float iq2_s_ep_dot32_diag(uint q, uint sign, uchar qh, uchar sc, float db, thread const float * yl) {
    const uchar4 qs = as_type<uchar4>(q);
    const uchar4 signs = as_type<uchar4>(sign);
    const float d1 = db * (0.5f + (sc & 0xf));
    const float d2 = db * (0.5f + (sc >> 4));
    float2 sum = {0.f};
    for (short l = 0; l < 2; ++l) {
        const int index1 = qs[l] | ((qh << (8-2*l)) & 0x300);
        const int index2 = qs[l+2] | ((qh << (4-2*l)) & 0x300);
        // Mix every index bit into finite synthetic grid bytes without a lookup.
        const uchar4 pattern1 = as_type<uchar4>(0x2b2b2b2bu ^ ((uint(index1)*0x9e3779b9u) & 0x01010101u));
        const uchar4 pattern2 = as_type<uchar4>(0x2b2b2b2bu ^ ((uint(index2)*0x9e3779b9u) & 0x01010101u));
        for (short j = 0; j < 8; ++j) {
            float w1, w2;
            if (DIAG == 1 || DIAG == 3) {
                w1 = float(pattern1[j%4]);
                w2 = float(pattern2[j%4]);
            } else {
                w1 = float(((constant uchar *)(iq2s_grid + index1))[j]);
                w2 = float(((constant uchar *)(iq2s_grid + index2))[j]);
            }
            if (DIAG != 2 && DIAG != 3) {
                w1 *= select(1, -1, signs[l] & kmask_iq2xs[j]);
                w2 *= select(1, -1, signs[l+2] & kmask_iq2xs[j]);
            }
            if (DIAG == 4) {
                sum[0] += w1;
                sum[1] += w2;
            } else {
                sum[0] += yl[8*l+j]*w1;
                sum[1] += yl[8*l+j+16]*w2;
            }
        }
    }
    float result = d1*sum[0] + d2*sum[1];
    if (DIAG == 2 || DIAG == 3) {
        result += float(sign)*0x1p-32f;
    }
    return result;
}

template<bool ALIGNED = false, int DIAG = 0>
inline float moe_gate_up_dot_iq2_s_ep(device const char * expert, ulong block, ulong blocks, short ib, thread const float * yl) {
    device const uchar * payload = (device const uchar *)expert + 80*block;
    const uint qs = iq2_s_ep_load32(payload + 4*ib, ALIGNED || blocks%2 == 0);
    const uint signs = iq2_s_ep_load32(payload + 32 + 4*ib, ALIGNED || blocks%2 == 0);
    const float d = ((device const half *)(expert + 80*blocks))[block];
    if (DIAG != 0) {
        return iq2_s_ep_dot32_diag<DIAG>(qs, signs, payload[64+ib], payload[72+ib], d, yl);
    }
    return iq2_s_ep_dot32(qs, signs, payload[64+ib], payload[72+ib], d, yl);
}

inline float iq2_s_ep_dot8_half(int index, uchar signs, half4 y0, half4 y1) {
    const uint2 grid = ((constant uint2 *)iq2s_grid)[index];
    const half4 g0 = half4(as_type<uchar4>(grid.x));
    const half4 g1 = half4(as_type<uchar4>(grid.y));
    const ushort4 mask0 = ((ushort4(signs) >> ushort4(0, 1, 2, 3)) & ushort4(1)) << 15;
    const ushort4 mask1 = ((ushort4(signs) >> ushort4(4, 5, 6, 7)) & ushort4(1)) << 15;
    return float(dot(as_type<half4>(as_type<ushort4>(g0) ^ mask0), y0)) +
           float(dot(as_type<half4>(as_type<ushort4>(g1) ^ mask1), y1));
}

inline float iq2_s_ep_dot16_values(ushort q, ushort sign, uchar qh, thread const float * yl) {
    const uchar2 qs = as_type<uchar2>(q);
    const uchar2 signs = as_type<uchar2>(sign);
    float sum = 0.f;
    for (short l = 0; l < 2; ++l) {
        const int index = qs[l] | ((qh << (8-2*l)) & 0x300);
        constant uchar * grid = (constant uchar *)(iq2s_grid + index);
        for (short j = 0; j < 8; ++j) {
            sum += yl[8*l+j] * float(grid[j]) * select(1, -1, signs[l] & kmask_iq2xs[j]);
        }
    }
    return sum;
}

inline float iq2_s_ep_dot16_values(ushort q, ushort sign, uchar qh, thread const half4 * yl) {
    const uchar2 qs = as_type<uchar2>(q);
    const uchar2 signs = as_type<uchar2>(sign);
    float sum = 0.f;
    for (short l = 0; l < 2; ++l) {
        const int index = qs[l] | ((qh << (8-2*l)) & 0x300);
        sum += iq2_s_ep_dot8_half(index, signs[l], yl[2*l], yl[2*l+1]);
    }
    return sum;
}

template<typename y_t>
inline float moe_gate_up_dot_iq2_s_ep_16(device const char * expert, ulong block, ulong blocks, short il16, y_t yl) {
    device const uchar * payload = (device const uchar *)expert + 80*block;
    const ushort qs = *((device const ushort *)(payload + 2*il16));
    const ushort signs = *((device const ushort *)(payload + 32 + 2*il16));
    const short shift = 4*(il16%2);
    const uchar qh = payload[64+il16/2] >> shift;
    const uchar sc = (payload[72+il16/2] >> shift) & 15;
    const float d = ((device const half *)(expert + 80*blocks))[block];
    return d*(0.5f + sc)*iq2_s_ep_dot16_values(qs, signs, qh, yl);
}

inline float moe_gate_up_dot_iq2_s_ep_half(device const char * expert, ulong block, ulong blocks, short ib, thread const half4 * yl) {
    device const uchar * payload = (device const uchar *)expert + 80*block;
    const uint qs = *((device const uint *)(payload + 4*ib));
    const uint signs = *((device const uint *)(payload + 32 + 4*ib));
    const uchar qh = payload[64+ib];
    const uchar sc = payload[72+ib];
    const float d = ((device const half *)(expert + 80*blocks))[block];
    const float lo = iq2_s_ep_dot16_values(ushort(qs), ushort(signs), qh, yl);
    const float hi = iq2_s_ep_dot16_values(ushort(qs >> 16), ushort(signs >> 16), qh >> 4, yl + 4);
    return d*(0.5f + (sc & 15))*lo + d*(0.5f + (sc >> 4))*hi;
}

inline float moe_gate_up_dot_iq2_s_ep_wide(device const char * expert, ulong block, ulong blocks, short half_block, threadgroup const float * y) {
    device const uchar * payload = (device const uchar *)expert + 80*block;
    const uint4 qs = *((device const uint4 *)(payload + 16*half_block));
    const uint4 signs = *((device const uint4 *)(payload + 32 + 16*half_block));
    const uint qh = *((device const uint *)(payload + 64 + 4*half_block));
    const uint sc = *((device const uint *)(payload + 72 + 4*half_block));
    const float d = ((device const half *)(expert + 80*blocks))[block];
    float sum = 0.f;
#pragma unroll
    for (short i = 0; i < 4; ++i) {
        sum += iq2_s_ep_dot32(qs[i], signs[i], uchar(qh >> (8*i)), uchar(sc >> (8*i)), d, y + 32*i);
    }
    return sum;
}

void kernel_mul_mv_iq2_s_ep_f32_impl(
        ggml_metal_kargs_mul_mv args,
        device const char * src0,
        device const char * src1,
        device char * dst,
        threadgroup char * shmem,
        uint3 tgpig,
        ushort tiisg,
        ushort sgitg) {
    const int first_row = (tgpig.x*FC_mul_mv_nsg + sgitg)*2;
    const int nb = args.ne00/256;
    device const float * y = (device const float *)(src1 + tgpig.y*args.nb11);
    float sum[2] = {0.f};
    float yl[32];
    for (int ib32 = tiisg; ib32 < args.ne00/32; ib32 += 32) {
        for (short i = 0; i < 32; ++i) {
            yl[i] = y[32*ib32+i];
        }
        for (short row = 0; row < 2 && first_row + row < args.ne01; ++row) {
            const ulong block = ulong(first_row + row)*nb + ib32/8;
            sum[row] += moe_gate_up_dot_iq2_s_ep(src0, block, ulong(args.ne01)*nb, ib32%8, yl);
        }
    }
    for (short row = 0; row < 2; ++row) {
        const float value = simd_sum(sum[row])*0.25f;
        if (tiisg == 0 && first_row + row < args.ne0) {
            ((device float *)dst)[tgpig.y*args.ne0 + first_row + row] = value;
        }
    }
}

typedef decltype(mmv_fn<kernel_mul_mv_t_t_disp<half, half, ggml_metal_kargs_mul_mv>>) mul_mv_disp_fn_t;

template<mul_mv_disp_fn_t disp_fn>
kernel void kernel_mul_mv_id(
        constant ggml_metal_kargs_mul_mv_id & args,
        device const char * src0s,
        device const char * src1,
        device       char * dst,
        device const char * ids,
        threadgroup  char * shmem [[threadgroup(0)]],
        uint3  tgpig[[threadgroup_position_in_grid]],
        ushort tiitg[[thread_index_in_threadgroup]],
        ushort tiisg[[thread_index_in_simdgroup]],
        ushort sgitg[[simdgroup_index_in_threadgroup]]) {
    const int iid1 = tgpig.z/args.nei0;
    const int idx  = tgpig.z%args.nei0;

    tgpig.z = 0;

    const int32_t i02 = ((device const int32_t *) (ids + iid1*args.nbi1))[idx];

    const int64_t i11 = idx % args.ne11;
    const int64_t i12 = iid1;

    const int64_t i1 = idx;
    const int64_t i2 = i12;

    device const char * src0_cur = src0s + i02*args.nb02;
    device const char * src1_cur = src1  + i11*args.nb11 + i12*args.nb12;

    device char * dst_cur = dst + (i1*args.ne0 + i2*args.ne1*args.ne0)*sizeof(float);

    ggml_metal_kargs_mul_mv args0 = {
        /*.ne00 =*/ args.ne00,
        /*.ne01 =*/ args.ne01,
        /*.ne02 =*/ 1, // args.ne02,
        /*.nb00 =*/ args.nb00,
        /*.nb01 =*/ args.nb01,
        /*.nb02 =*/ args.nb02,
        /*.nb03 =*/ args.nb02, // args.ne02 == 1
        /*.ne10 =*/ args.ne10,
        /*.ne11 =*/ 1, // args.ne11,
        /*.ne12 =*/ 1, // args.ne12,
        /*.nb10 =*/ args.nb10,
        /*.nb11 =*/ args.nb11,
        /*.nb12 =*/ args.nb12,
        /*.nb13 =*/ args.nb12, // ne12 == 1
        /*.ne0  =*/ args.ne0,
        /*.ne1  =*/ 1, // args.ne1,
        /*.nr0  =*/ args.nr0,
        /*.r2   =*/ 1,
        /*.r3   =*/ 1,
    };

    disp_fn(
        args0,
        /* src0 */ src0_cur,
        /* src1 */ src1_cur,
        /* dst  */ dst_cur,
        shmem,
        tgpig,
        tiitg,
        tiisg,
        sgitg);
}

